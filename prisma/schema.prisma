generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Announcement {
  id        String   @id @default(uuid())
  text      String
  link      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Event {
  id          String   @id @default(uuid())
  title       String
  date        DateTime
  description String
  images      String?  
  isPast      Boolean  @default(false)
}

model Seva {
  id          String   @id @default(uuid())
  name        String
  description String
  price       Float
  timing      String
  eligibility String?
  bookings    Booking[]
}

model Booking {
  id          String   @id @default(uuid())
  sevaId      String
  seva        Seva     @relation(fields: [sevaId], references: [id])
  devoteeName String
  contact     String
  date        DateTime
  gotra       String?
  nakshatra   String?
  status      String   @default("PENDING") 
  paymentRef  String?
  createdAt   DateTime @default(now())
}

model Donation {
  id          String   @id @default(uuid())
  category    String   
  amount      Float
  donorName   String
  contact     String
  status      String   @default("PENDING")
  paymentRef  String?
  createdAt   DateTime @default(now())
}

model Accommodation {
  id          String   @id @default(uuid())
  devoteeName String
  contact     String
  dates       String
  guests      Int
  status      String   @default("REQUESTED")
}

model AdminUser {
  id       String @id @default(uuid())
  email    String @unique
  password String 
  role     String @default("EDITOR") 
}
